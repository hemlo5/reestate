# APP_URL: The URL where this applet is hosted (Cloud Run service URL or http://localhost:3000).
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AUTH_SECRET: HMAC signing key for HTTP-only session cookies (generate a 32+ char random string in production).
AUTH_SECRET="dev-housed-change-this-secret-in-production"

# SUPABASE POSTGRES & STORAGE (Optional in local dev; falls back cleanly to SQLite + local disk uploads when unset)
DATABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

