{
  "name": "hemlo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node -e \"const fs=require('fs'),net=require('net');const s=net.connect(3000,'127.0.0.1');s.on('connect',()=>{s.destroy();process.exit(0)});s.on('error',()=>{try{fs.unlinkSync('.next/dev/lock')}catch{};process.exit(0)})\" && cross-env DATABASE_URL= NODE_ENV=development NODE_OPTIONS=--no-warnings=ExperimentalWarning next dev -H 0.0.0.0 -p 3000",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start -p 3000",
    "clean": "node -e \"for(const p of ['.next','dist','server.js'])require('fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/pg": "^8.23.1",
    "lucide-react": "^0.546.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
